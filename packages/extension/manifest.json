{
  "manifest_version": 3,
  "name": "IcpFinder for Chrome",
  "version": "0.1.0",
  "description": "Lets the IcpFinder Mac app read Reddit, X and LinkedIn search pages in your browser, where you are signed in. Read only: it never clicks, types or posts.",
  "key": "",
  "permissions": ["alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://x.com/*",
    "https://www.linkedin.com/*",
    "http://127.0.0.1:47321/*"
  ],
  "background": { "service_worker": "background.js" }
}
