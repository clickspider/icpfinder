{
  "name": "@icpfinder/desktop",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "IcpFinder for macOS: find your ICPs and prove why now, on your own Claude and Codex.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.4.11",
    "electron-vite": "2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "5.4.21",
    "vitest": "^2.1.0",
    "@icpfinder/core": "workspace:*",
    "@icpfinder/providers": "workspace:*",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.icpfinder.app",
    "productName": "IcpFinder",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "out/main/mcpBrowser.js"
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.business",
      "identity": "-",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "IcpFinder records a voice note only when you hold the mic in the idea chat."
      }
    },
    "dmg": {
      "title": "IcpFinder ${version}"
    },
    "npmRebuild": false
  }
}
